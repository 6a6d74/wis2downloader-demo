# Purge settings (read by docker compose). Change, then: docker compose up -d
# Files downloaded more than this many hours ago are deleted.
RETENTION_HOURS=36
# Safety cap: if the pile is still bigger than this (GB), the oldest files go first. 0 = no cap.
MAX_DOWNLOAD_GB=20
# How often the purger runs.
PURGE_INTERVAL_MINUTES=10

# Download only notifications whose data_id or canonical link matches this regular expression.
# ECMWF's topic also carries IFS 0.25°, waves and AIFS; /ifs/0p1/oper/ keeps the 0.1° IFS
# pressure-level and surface files. Empty (DATA_ID_FILTER=) downloads everything.
DATA_ID_FILTER=/ifs/0p1/oper/

# The containers run as this user and group, so downloaded files are yours.
# Set them to the output of `id -u` and `id -g` (1000 suits most Linux desktops).
HOST_UID=1000
HOST_GID=1000
